{
  "manifest_version": 3,
  "name": "Network Jitter",
  "version": "1.0.0",
  "description": "Periodic HTTP latency samples, jitter graphs, and incident drill-down for your network.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Network Jitter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "offscreen", "unlimitedStorage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
